# Used by docker-compose.yml. Copy to .env and fill in the values.

# Use URL-safe characters only (letters, numbers, - and _)
POSTGRES_USER=edusystem
POSTGRES_PASSWORD=
POSTGRES_DB=edusystem

# At least 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
DATA_ENCRYPTION_KEY=

# Port the site is published on
WEB_PORT=8080

# Keep false while serving over http://localhost, set true behind HTTPS
COOKIE_SECURE=false

# Optional initial administrator
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
